{
  "manifest_version": 3,
  "name": "Chrome AI Translator",
  "version": "0.1.6",
  "minimum_chrome_version": "116",
  "description": "划词、双语网页与专业术语 AI 翻译",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 AI 翻译侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
